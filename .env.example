# ---- Database (Supabase Postgres) ----
# Settings -> Database -> Connection string.
# DATABASE_URL: the "Transaction pooler" URI (port 6543) - used at runtime by serverless functions.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: the "Direct connection" URI (port 5432) - used only for `prisma db push` / migrations.
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ---- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ----
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxx"

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="xxxxx"
# Full deployed URL in production, e.g. https://your-app.vercel.app. http://localhost:3000 for local dev.
NEXTAUTH_URL="http://localhost:3000"

# ---- Admin allow-list ----
# Comma-separated emails that are auto-promoted to ADMIN on first sign-in.
ADMIN_EMAILS="you@example.com"

# ---- Supabase Storage ----
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"
# Service role key - server-side only, NEVER exposed to the client. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY="xxxxx"
# Name of the private storage bucket used for uploaded content (create this bucket, keep it Private).
# Not a secret - just an identifier - so it's exposed as NEXT_PUBLIC so the browser can
# redeem signed upload URLs directly against Supabase Storage during admin uploads.
NEXT_PUBLIC_SUPABASE_BUCKET="content"
