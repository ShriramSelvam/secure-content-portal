// Prisma schema for the Secure Content Portal.
// Run `npm run db:push` after setting DATABASE_URL / DIRECT_URL to create these tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  VIEWER
  ADMIN
}

enum ContentType {
  VIDEO
  PDF
  HTML
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  image     String?
  role      Role      @default(VIEWER)
  createdAt DateTime  @default(now())
  content   Content[]
}

model Content {
  id           String      @id @default(cuid())
  title        String
  description  String?
  category     String?
  type         ContentType
  storagePath  String // path inside the private Supabase Storage bucket
  mimeType     String
  size         Int // bytes
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  uploadedBy   User        @relation(fields: [uploadedById], references: [id])
  uploadedById String
}
